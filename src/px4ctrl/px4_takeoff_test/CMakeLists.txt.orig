cmake_minimum_required(VERSION 3.0.2)
project(px4_takeoff_test)

find_package(catkin REQUIRED COMPONENTS
  geometry_msgs
  mavros_msgs
  nav_msgs
  quadrotor_msgs
  rospy
  rosgraph
  sensor_msgs
)

catkin_package()

catkin_install_python(PROGRAMS
  scripts/fixed_odometry_test.py
  scripts/bench_motor_test.py
  scripts/safe_takeoff.py
  scripts/px4ctrl_bench_takeoff_sequence.py
  scripts/nokov_odometry_node.py
  scripts/px4ctrl_nokov_takeoff_sequence.py
  DESTINATION ${CATKIN_PACKAGE_BIN_DESTINATION}
)

install(DIRECTORY launch config
  DESTINATION ${CATKIN_PACKAGE_SHARE_DESTINATION}
)
