<launch>
  <!-- 参数主要在YAML中修改；config_file允许为不同场地保存独立标定配置。 -->
  <arg name="config_file"
       default="$(find px4_takeoff_test)/config/nokov_odometry.yaml"/>
  <arg name="output_topic" default="/nokov/odometry"/>

  <node pkg="px4_takeoff_test"
        type="nokov_odometry_node.py"
        name="nokov_odometry"
        output="screen"
        required="true">
    <rosparam command="load" file="$(arg config_file)"/>
    <!-- launch参数在YAML之后加载，因此可在命令行临时覆盖输出话题。 -->
    <param name="output_topic" value="$(arg output_topic)"/>
  </node>
</launch>
