<launch>
  <!--
    一键启动MAVROS、固定Odometry、px4ctrl，并可选择自动触发短时无桨测试。
    固定Odometry不是真实定位：本launch严禁安装桨叶，严禁用于实际飞行。
  -->
  <arg name="fcu_url"
       default="/dev/serial/by-id/usb-3D_Robotics_PX4_FMU_v5.x_0-if00:57600"/>
  <arg name="mavros_ns" default="/mavros"/>
  <arg name="odom_topic" default="/test/odometry"/>

  <!-- 所有安全确认默认关闭，必须由操作者在命令行显式设置。 -->
  <arg name="confirm_stationary" default="true"/>
  <arg name="allow_armed" default="true"/>
  <arg name="confirm_propellers_removed" default="true"/>
  <!-- <arg name="auto_trigger" default="false"/> -->
  <arg name="auto_trigger" default="true"/>

  <arg name="odom_duration" default="30.0"/>
  <arg name="odom_rate" default="100.0"/>

  <!--
    MAVROS与固定Odometry立即启动；px4ctrl等待该时长后再启动。
    该延迟不替代自动触发节点的数据就绪检查。
  -->
  <arg name="px4ctrl_start_delay" default="3.0"/>

  <arg name="test_duration" default="3.0"/>
  <arg name="start_timeout" default="30.0"/>
  <!-- TAKEOFF前要求px4ctrl姿态setpoint连续稳定的时间。 -->
  <arg name="setpoint_warmup" default="3.0"/>
  <arg name="arm_timeout" default="10.0"/>
  <arg name="disarm_timeout" default="6.0"/>

  <include file="$(find mavros)/launch/px4.launch">
    <arg name="fcu_url" value="$(arg fcu_url)"/>
  </include>

  <include file="$(find px4_takeoff_test)/launch/fixed_odometry_test.launch">
    <arg name="confirm_stationary" value="$(arg confirm_stationary)"/>
    <arg name="allow_armed" value="$(arg allow_armed)"/>
    <arg name="confirm_propellers_removed"
         value="$(arg confirm_propellers_removed)"/>
    <arg name="output_topic" value="$(arg odom_topic)"/>
    <arg name="duration" value="$(arg odom_duration)"/>
    <arg name="rate" value="$(arg odom_rate)"/>
  </include>

  <include file="$(find px4ctrl)/launch/run_ctrl.launch">
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="start_delay" value="$(arg px4ctrl_start_delay)"/>
  </include>

  <!--
    auto_trigger=false时只启动三个基础组件，不发送起飞消息。
    auto_trigger=true时启动required顺序节点：测试完成/失败后关闭整个launch。
  -->
  <node if="$(arg auto_trigger)"
        pkg="px4_takeoff_test"
        type="px4ctrl_bench_takeoff_sequence.py"
        name="px4ctrl_bench_takeoff_sequence"
        output="screen"
        required="true">
    <param name="confirm_propellers_removed"
           value="$(arg confirm_propellers_removed)"/>
    <param name="confirm_fixed_odometry_bench" value="$(arg auto_trigger)"/>
    <param name="mavros_ns" value="$(arg mavros_ns)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="test_duration" value="$(arg test_duration)"/>
    <param name="start_timeout" value="$(arg start_timeout)"/>
    <param name="setpoint_warmup" value="$(arg setpoint_warmup)"/>
    <param name="arm_timeout" value="$(arg arm_timeout)"/>
    <param name="disarm_timeout" value="$(arg disarm_timeout)"/>
  </node>
</launch>
