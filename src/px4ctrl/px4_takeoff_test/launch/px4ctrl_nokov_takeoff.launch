<launch>
  <!--
    MAVROS和NOKOV立即启动，px4ctrl延迟启动；顺序节点最后等待全部数据真实就绪。
    本文件使用真实动捕定位，不能与fixed_odometry_test同时运行。
  -->
  <arg name="fcu_url"
       default="/dev/serial/by-id/usb-3D_Robotics_PX4_FMU_v5.x_0-if00:57600"/>
  <arg name="nokov_config"
       default="$(find px4_takeoff_test)/config/nokov_odometry.yaml"/>
  <arg name="odom_topic" default="/nokov/odometry"/>
  <arg name="px4ctrl_start_delay" default="5.0"/>

  <!-- 自动起飞默认需要操作者显式确认；false时三个基础节点仍会启动。 -->
  <arg name="auto_trigger" default="true"/>
  <arg name="confirm_flight" default="true"/>
  <arg name="require_rc" default="true"/>
  <arg name="start_timeout" default="60.0"/>
  <arg name="stable_time" default="3.0"/>
  <arg name="arm_timeout" default="10.0"/>
  <arg name="takeoff_retry_interval" default="3.0"/>
  <arg name="takeoff_max_attempts" default="3"/>
  <!-- MAVROS状态类话题约1Hz，超时必须大于一个消息周期。 -->
  <arg name="state_timeout" default="2.5"/>
  <arg name="extended_state_timeout" default="2.5"/>
  <!-- 允许自动起飞时油门杆保持最低位；横滚、俯仰、偏航仍须居中。 -->
  <arg name="allow_low_throttle" default="true"/>
  <arg name="rc_low_throttle_max" default="1125"/>
  <!--
    ARM后先在takeoff_timeout内等待达到目标高度；高度与垂直速度连续稳定后，
    计算已设置的flight_duration，否则计算hover_duration；之后LAND并等待DISARM。
  -->
  <arg name="takeoff_timeout" default="30.0"/>
  <arg name="takeoff_height_tolerance" default="0.05"/>
  <arg name="takeoff_settle_time" default="0.5"/>
  <arg name="takeoff_settle_vertical_speed" default="0.20"/>
  <arg name="hover_duration" default="40.0"/>
  <!--
    可选飞行计时，从确认达到目标高度后开始；-1表示不额外设置飞行时间。
    设置为非负数时优先于hover_duration，到时在当前位置请求LAND。
  -->
  <arg name="flight_duration" default="-1.0"/>
  <arg name="landing_timeout" default="60.0"/>
  <arg name="minimum_odom_rate" default="30.0"/>
  <arg name="maximum_takeoff_speed" default="0.1"/>

  <include file="$(find px4_takeoff_test)/launch/px4ctrl_nokov_odometry.launch">
    <arg name="fcu_url" value="$(arg fcu_url)"/>
    <arg name="nokov_config" value="$(arg nokov_config)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="px4ctrl_start_delay" value="$(arg px4ctrl_start_delay)"/>
  </include>

  <!--
    该节点不使用required=true：它会在定时结束后先LAND并等待DISARM才退出；
    MAVROS、NOKOV和px4ctrl在整个飞行及降落阶段始终保持运行。
  -->
  <node if="$(arg auto_trigger)"
        pkg="px4_takeoff_test"
        type="px4ctrl_nokov_takeoff_sequence.py"
        name="px4ctrl_nokov_takeoff_sequence"
        output="screen">
    <param name="confirm_flight" value="$(arg confirm_flight)"/>
    <param name="mavros_ns" value="/mavros"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="require_rc" value="$(arg require_rc)"/>
    <param name="start_timeout" value="$(arg start_timeout)"/>
    <param name="stable_time" value="$(arg stable_time)"/>
    <param name="arm_timeout" value="$(arg arm_timeout)"/>
    <param name="takeoff_retry_interval"
           value="$(arg takeoff_retry_interval)"/>
    <param name="takeoff_max_attempts"
           value="$(arg takeoff_max_attempts)"/>
    <param name="state_timeout" value="$(arg state_timeout)"/>
    <param name="extended_state_timeout"
           value="$(arg extended_state_timeout)"/>
    <param name="allow_low_throttle" value="$(arg allow_low_throttle)"/>
    <param name="rc_low_throttle_max"
           value="$(arg rc_low_throttle_max)"/>
    <param name="takeoff_timeout" value="$(arg takeoff_timeout)"/>
    <param name="takeoff_height_tolerance"
           value="$(arg takeoff_height_tolerance)"/>
    <param name="takeoff_settle_time" value="$(arg takeoff_settle_time)"/>
    <param name="takeoff_settle_vertical_speed"
           value="$(arg takeoff_settle_vertical_speed)"/>
    <param name="hover_duration" value="$(arg hover_duration)"/>
    <param name="flight_duration" value="$(arg flight_duration)"/>
    <param name="landing_timeout" value="$(arg landing_timeout)"/>
    <param name="minimum_odom_rate" value="$(arg minimum_odom_rate)"/>
    <param name="maximum_takeoff_speed" value="$(arg maximum_takeoff_speed)"/>
  </node>
</launch>
