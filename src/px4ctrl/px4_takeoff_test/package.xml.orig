<?xml version="1.0"?>
<package format="2">
  <name>px4_takeoff_test</name>
  <version>0.1.0</version>
  <description>A guarded MAVROS OFFBOARD takeoff, hover, and landing example for PX4.</description>

  <maintainer email="jin@localhost.com">jin</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>rospy</depend>

  <export/>
</package>
