#!/usr/bin/env python3
"""把 NOKOV 官方 SDK 的刚体数据转换为 ROS ``nav_msgs/Odometry``。

本节点只负责定位数据桥接，不会发送解锁、模式切换、推力或起飞命令。NOKOV
SDK 中的位置单位是毫米，本节点转换为米；SDK 当前安装版本不含速度扩展字段，
因此线速度和角速度由相邻有效帧差分计算。

参数统一放在 ``config/nokov_odometry.yaml`` 中。最重要的参数是：

* ``server_ip``：NOKOV Seeker/服务器所在计算机的 IPv4 地址；
* ``rigid_body_selector``：明确选择按 ``name`` 或 ``id`` 查找刚体；
* ``rigid_body_name`` / ``rigid_body_id``：对应选择方式使用的值；
* ``world_axis_map``：把 NOKOV 世界坐标变为 ROS 世界坐标；
* ``body_axis_map``：把 NOKOV 刚体坐标变为 ROS 机体系；
* ``output_topic``：输出的 Odometry 话题。

轴映射是三个带符号的轴名。例如 ``[x, z, -y]`` 表示：
ROS.x=NOKOV.x、ROS.y=NOKOV.z、ROS.z=-NOKOV.y。映射必须是右手系，三个轴
各使用一次。位置、姿态和速度会使用同一个严格一致的坐标变换。
"""

import math
import threading

import rospy
from nav_msgs.msg import Odometry

try:
    # 使用 NOKOV 官方 wheel 提供的 ctypes 封装和原生 libnokov_sdk.so。
    from nokov import nokovsdk
except (ImportError, OSError) as exc:
    nokovsdk = None
    NOKOV_IMPORT_ERROR = exc
else:
    NOKOV_IMPORT_ERROR = None


def _mat_transpose(matrix):
    """返回 3x3 矩阵的转置。"""
    return [[matrix[column][row] for column in range(3)] for row in range(3)]


def _mat_multiply(left, right):
    """计算两个 3x3 矩阵的乘积。"""
    return [
        [sum(left[row][k] * right[k][column] for k in range(3))
         for column in range(3)]
        for row in range(3)
    ]


def _mat_vector(matrix, vector):
    """用 3x3 矩阵变换三维向量。"""
    return [sum(matrix[row][k] * vector[k] for k in range(3)) for row in range(3)]


def _determinant(matrix):
    """计算 3x3 矩阵行列式，用于拒绝左手系/镜像轴映射。"""
    return (
        matrix[0][0] * (matrix[1][1] * matrix[2][2] - matrix[1][2] * matrix[2][1])
        - matrix[0][1] * (matrix[1][0] * matrix[2][2] - matrix[1][2] * matrix[2][0])
        + matrix[0][2] * (matrix[1][0] * matrix[2][1] - matrix[1][1] * matrix[2][0])
    )


def _parse_axis_map(value, parameter_name):
    """把 ``[x, z, -y]`` 解析为右手系旋转矩阵。"""
    if not isinstance(value, list) or len(value) != 3:
        raise ValueError("{} 必须是含3项的列表，例如 [x, y, z]".format(parameter_name))

    axis_index = {"x": 0, "y": 1, "z": 2}
    matrix = [[0.0] * 3 for _ in range(3)]
    used_axes = set()
    for output_axis, item in enumerate(value):
        token = str(item).strip().lower()
        sign = -1.0 if token.startswith("-") else 1.0
        source_axis = token[1:] if token[:1] in ("+", "-") else token
        if source_axis not in axis_index or source_axis in used_axes:
            raise ValueError(
                "{}={} 无效：x/y/z 必须各使用一次".format(parameter_name, value)
            )
        used_axes.add(source_axis)
        matrix[output_axis][axis_index[source_axis]] = sign

    if _determinant(matrix) < 0.5:
        raise ValueError(
            "{}={} 构成左手系；请调整一个轴的符号，保证右手系".format(
                parameter_name, value
            )
        )
    return matrix


def _normalize_quaternion(quaternion):
    """归一化 ``[x,y,z,w]`` 四元数；无效输入返回 None。"""
    if not all(math.isfinite(value) for value in quaternion):
        return None
    norm = math.sqrt(sum(value * value for value in quaternion))
    if norm < 1.0e-8:
        return None
    return [value / norm for value in quaternion]


def _quaternion_to_matrix(quaternion):
    """把 ``[x,y,z,w]`` 四元数转换为 3x3 旋转矩阵。"""
    x, y, z, w = quaternion
    return [
        [1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y - z * w),
         2.0 * (x * z + y * w)],
        [2.0 * (x * y + z * w), 1.0 - 2.0 * (x * x + z * z),
         2.0 * (y * z - x * w)],
        [2.0 * (x * z - y * w), 2.0 * (y * z + x * w),
         1.0 - 2.0 * (x * x + y * y)],
    ]


def _matrix_to_quaternion(matrix):
    """把正交旋转矩阵转换为归一化的 ``[x,y,z,w]`` 四元数。"""
    trace = matrix[0][0] + matrix[1][1] + matrix[2][2]
    if trace > 0.0:
        scale = math.sqrt(trace + 1.0) * 2.0
        quaternion = [
            (matrix[2][1] - matrix[1][2]) / scale,
            (matrix[0][2] - matrix[2][0]) / scale,
            (matrix[1][0] - matrix[0][1]) / scale,
            0.25 * scale,
        ]
    elif matrix[0][0] > matrix[1][1] and matrix[0][0] > matrix[2][2]:
        scale = math.sqrt(1.0 + matrix[0][0] - matrix[1][1] - matrix[2][2]) * 2.0
        quaternion = [
            0.25 * scale,
            (matrix[0][1] + matrix[1][0]) / scale,
            (matrix[0][2] + matrix[2][0]) / scale,
            (matrix[2][1] - matrix[1][2]) / scale,
        ]
    elif matrix[1][1] > matrix[2][2]:
        scale = math.sqrt(1.0 + matrix[1][1] - matrix[0][0] - matrix[2][2]) * 2.0
        quaternion = [
            (matrix[0][1] + matrix[1][0]) / scale,
            0.25 * scale,
            (matrix[1][2] + matrix[2][1]) / scale,
            (matrix[0][2] - matrix[2][0]) / scale,
        ]
    else:
        scale = math.sqrt(1.0 + matrix[2][2] - matrix[0][0] - matrix[1][1]) * 2.0
        quaternion = [
            (matrix[0][2] + matrix[2][0]) / scale,
            (matrix[1][2] + matrix[2][1]) / scale,
            0.25 * scale,
            (matrix[1][0] - matrix[0][1]) / scale,
        ]
    return _normalize_quaternion(quaternion)


def _rotation_vector(previous_rotation, current_rotation, dt):
    """由两帧姿态计算机体系角速度（rad/s）。"""
    relative = _mat_multiply(_mat_transpose(previous_rotation), current_rotation)
    cosine = max(-1.0, min(1.0, (relative[0][0] + relative[1][1] + relative[2][2] - 1.0) / 2.0))
    angle = math.acos(cosine)
    if angle < 1.0e-7:
        return [0.0, 0.0, 0.0]
    sine = math.sin(angle)
    if abs(sine) < 1.0e-7:
        return [0.0, 0.0, 0.0]
    factor = angle / (2.0 * sine * dt)
    return [
        factor * (relative[2][1] - relative[1][2]),
        factor * (relative[0][2] - relative[2][0]),
        factor * (relative[1][0] - relative[0][1]),
    ]


def _covariance(linear_variance, angular_variance):
    """创建 ROS 6x6 对角协方差数组。"""
    result = [0.0] * 36
    for index in (0, 7, 14):
        result[index] = linear_variance
    for index in (21, 28, 35):
        result[index] = angular_variance
    return result


class NokovOdometryNode:
    """连接 NOKOV 服务器、选择刚体并持续发布 Odometry。"""

    def __init__(self):
        if nokovsdk is None:
            raise RuntimeError(
                "无法导入NOKOV官方Python SDK: {}。请先安装厂家提供的nokovpy wheel"
                .format(NOKOV_IMPORT_ERROR)
            )

        # 网络、刚体与ROS接口参数。
        self.server_ip = str(rospy.get_param("~server_ip", "10.1.1.198"))
        self.rigid_body_selector = str(
            rospy.get_param("~rigid_body_selector", "name")
        ).strip().lower()
        self.rigid_body_name = str(rospy.get_param("~rigid_body_name", "UAV"))
        self.rigid_body_id = int(rospy.get_param("~rigid_body_id", -1))
        if self.rigid_body_selector not in ("name", "id"):
            raise ValueError("rigid_body_selector只能设置为name或id")
        if self.rigid_body_selector == "name" and not self.rigid_body_name:
            raise ValueError("按名称选择刚体时，rigid_body_name不能为空")
        if self.rigid_body_selector == "id" and self.rigid_body_id < 0:
            raise ValueError("按ID选择刚体时，rigid_body_id必须大于或等于0")
        self.output_topic = str(rospy.get_param("~output_topic", "/nokov/odometry"))
        self.frame_id = str(rospy.get_param("~frame_id", "odom"))
        self.child_frame_id = str(rospy.get_param("~child_frame_id", "base_link"))

        # NOKOV位置默认是毫米；0.001把毫米换算成ROS使用的米。
        self.position_scale = float(rospy.get_param("~position_scale", 0.001))
        self.position_offset = [float(value) for value in rospy.get_param(
            "~position_offset", [0.0, 0.0, 0.0]
        )]
        if len(self.position_offset) != 3:
            raise ValueError("position_offset必须含3个数")
        self.zero_position_at_start = bool(rospy.get_param("~zero_position_at_start", False))

        # 世界轴映射左乘姿态矩阵，机体轴映射的转置右乘姿态矩阵：
        # R_ros = M_world * R_nokov * transpose(M_body)。
        self.world_map = _parse_axis_map(
            rospy.get_param("~world_axis_map", ["x", "y", "z"]),
            "world_axis_map",
        )
        self.body_map = _parse_axis_map(
            rospy.get_param("~body_axis_map", ["x", "y", "z"]),
            "body_axis_map",
        )

        # 速度由相邻接收帧差分。alpha=1表示不平滑，越小越平滑但延迟越大。
        self.velocity_alpha = float(rospy.get_param("~velocity_smoothing_alpha", 0.35))
        self.velocity_alpha = max(0.0, min(1.0, self.velocity_alpha))
        self.minimum_dt = float(rospy.get_param("~minimum_dt", 0.001))
        self.maximum_dt = float(rospy.get_param("~maximum_dt", 0.25))
        self.twist_linear_frame = str(rospy.get_param("~twist_linear_frame", "world")).lower()
        if self.twist_linear_frame not in ("world", "child"):
            raise ValueError("twist_linear_frame只能是world或child")

        # tracking_valid_mask=0表示不解释厂家未公开定义的params位；若现场SDK确认
        # 某一位是有效跟踪标志，可设置相应掩码（常见配置为1）。
        self.tracking_valid_mask = int(rospy.get_param("~tracking_valid_mask", 0))
        self.max_mean_error = float(rospy.get_param("~max_mean_error", 0.0))
        self.expected_rate = float(rospy.get_param("~expected_rate", 100.0))
        self.stale_timeout = float(rospy.get_param("~stale_timeout", 0.5))

        position_stddev = float(rospy.get_param("~position_stddev", 0.005))
        orientation_stddev = float(rospy.get_param("~orientation_stddev", 0.02))
        linear_velocity_stddev = float(rospy.get_param("~linear_velocity_stddev", 0.05))
        angular_velocity_stddev = float(rospy.get_param("~angular_velocity_stddev", 0.10))
        self.pose_covariance = _covariance(position_stddev ** 2, orientation_stddev ** 2)
        self.twist_covariance = _covariance(
            linear_velocity_stddev ** 2, angular_velocity_stddev ** 2
        )

        # 回调来自SDK原生线程，因此共享状态由锁保护。
        self.lock = threading.Lock()
        self.last_frame_number = None
        self.last_receive_time = None
        self.last_publish_time = None
        self.last_position = None
        self.last_rotation = None
        self.filtered_linear_velocity = [0.0, 0.0, 0.0]
        self.filtered_angular_velocity = [0.0, 0.0, 0.0]
        self.origin = None
        self.received_frames = 0
        self.published_frames = 0
        self.rate_window_start = rospy.Time.now()
        self.rate_window_count = 0

        self.publisher = rospy.Publisher(self.output_topic, Odometry, queue_size=20)
        self.client = nokovsdk.PySDKClient()
        version = self.client.PyNokovVersion()
        rospy.loginfo(
            "NOKOV SDK version %d.%d.%d.%d; connecting to %s",
            version[0], version[1], version[2], version[3], self.server_ip,
        )
        result = self.client.Initialize(self.server_ip.encode("utf-8"))
        if result != 0:
            raise RuntimeError(
                "连接NOKOV服务器 {} 失败，SDK返回码 {}".format(self.server_ip, result)
            )

        # 严格按照rigid_body_selector选择一种方式；不会再根据ID正负值隐式切换。
        descriptions = self._read_rigid_body_descriptions()
        if self.rigid_body_selector == "name":
            matching_ids = [body_id for body_id, name in descriptions.items()
                            if name == self.rigid_body_name]
            if not matching_ids:
                available = ", ".join(
                    "{}(ID={})".format(name, body_id)
                    for body_id, name in sorted(descriptions.items())
                ) or "服务器未返回刚体描述"
                raise RuntimeError(
                    "找不到刚体名称 {!r}；可用刚体: {}".format(
                        self.rigid_body_name, available
                    )
                )
            if len(matching_ids) > 1:
                raise RuntimeError(
                    "刚体名称 {!r} 对应多个ID {}，请改用id选择方式".format(
                        self.rigid_body_name, matching_ids
                    )
                )
            self.rigid_body_id = matching_ids[0]
        elif descriptions and self.rigid_body_id not in descriptions:
            available = ", ".join(
                "{}(ID={})".format(name, body_id)
                for body_id, name in sorted(descriptions.items())
            )
            raise RuntimeError(
                "找不到刚体ID {}；可用刚体: {}".format(
                    self.rigid_body_id, available
                )
            )
        resolved_name = descriptions.get(self.rigid_body_id, self.rigid_body_name)

        # SDK封装内部会保留CFUNCTYPE对象；成员引用再额外保证Python回调不被回收。
        self.data_callback = self._on_mocap_frame
        callback_result = self.client.PySetDataCallback(self.data_callback, None)
        if callback_result != 0:
            raise RuntimeError("设置NOKOV数据回调失败，SDK返回码 {}".format(callback_result))
        self.client.PySetVerbosityLevel(0)

        rospy.loginfo(
            "NOKOV connected: rigid body=%s (ID=%d), output=%s, frame=%s -> %s",
            resolved_name, self.rigid_body_id, self.output_topic,
            self.frame_id, self.child_frame_id,
        )
        rospy.logwarn(
            "请确认world_axis_map/body_axis_map与NOKOV工程及PX4机体系一致；错误轴向会导致失控"
        )
        self.status_timer = rospy.Timer(rospy.Duration(1.0), self._status_callback)

    def _read_rigid_body_descriptions(self):
        """读取刚体名称到ID的映射；只在启动阶段调用一次。"""
        pointer = nokovsdk.POINTER(nokovsdk.DataDescriptions)()
        result = self.client.PyGetDataDescriptions(pointer)
        if result != 0 or not pointer:
            if self.rigid_body_selector == "id":
                rospy.logwarn("NOKOV未返回数据描述；将直接使用rigid_body_id=%d", self.rigid_body_id)
                return {}
            raise RuntimeError("读取NOKOV刚体描述失败，SDK返回码 {}".format(result))

        descriptions = {}
        data = pointer.contents
        for index in range(data.nDataDescriptions):
            descriptor = data.arrDataDescriptions[index]
            if descriptor.type != nokovsdk.DataDescriptors.Descriptor_RigidBody.value:
                continue
            rigid_body = descriptor.Data.RigidBodyDescription.contents
            name = bytes(rigid_body.szName).split(b"\0", 1)[0].decode("utf-8", errors="replace")
            descriptions[int(rigid_body.ID)] = name
        return descriptions

    def _find_body(self, frame):
        """在一帧的刚体数组中按ID寻找目标刚体。"""
        for index in range(frame.nRigidBodies):
            body = frame.RigidBodies[index]
            if int(body.ID) == self.rigid_body_id:
                return body
        return None

    def _on_mocap_frame(self, frame_pointer, _user_data):
        """SDK原生线程的数据回调：校验、换系、估速并发布一帧Odometry。"""
        if not frame_pointer or rospy.is_shutdown():
            return
        try:
            frame = frame_pointer.contents
            now = rospy.Time.now()
            with self.lock:
                if frame.iFrame == self.last_frame_number:
                    return
                self.last_frame_number = int(frame.iFrame)
                self.last_receive_time = now
                self.received_frames += 1

                body = self._find_body(frame)
                if body is None:
                    rospy.logwarn_throttle(
                        1.0, "NOKOV帧中没有目标刚体ID=%d", self.rigid_body_id
                    )
                    return
                if self.tracking_valid_mask and not (int(body.params) & self.tracking_valid_mask):
                    rospy.logwarn_throttle(1.0, "目标刚体跟踪无效(params=%d)，本帧不发布", body.params)
                    return
                if self.max_mean_error > 0.0 and body.MeanError > self.max_mean_error:
                    rospy.logwarn_throttle(
                        1.0, "目标刚体MeanError %.3f超过阈值 %.3f，本帧不发布",
                        body.MeanError, self.max_mean_error,
                    )
                    return

                raw_position = [body.x * self.position_scale,
                                body.y * self.position_scale,
                                body.z * self.position_scale]
                raw_quaternion = _normalize_quaternion([body.qx, body.qy, body.qz, body.qw])
                if raw_quaternion is None or not all(math.isfinite(v) for v in raw_position):
                    rospy.logwarn_throttle(1.0, "NOKOV返回非有限位置或无效四元数，本帧不发布")
                    return

                position = _mat_vector(self.world_map, raw_position)
                if self.zero_position_at_start and self.origin is None:
                    self.origin = list(position)
                    rospy.loginfo("已把首个有效位置设为局部原点: [%.3f, %.3f, %.3f] m", *self.origin)
                if self.origin is not None:
                    position = [position[i] - self.origin[i] for i in range(3)]
                position = [position[i] + self.position_offset[i] for i in range(3)]

                raw_rotation = _quaternion_to_matrix(raw_quaternion)
                rotation = _mat_multiply(
                    _mat_multiply(self.world_map, raw_rotation),
                    _mat_transpose(self.body_map),
                )
                quaternion = _matrix_to_quaternion(rotation)
                if quaternion is None:
                    return

                linear_velocity = [0.0, 0.0, 0.0]
                angular_velocity = [0.0, 0.0, 0.0]
                if self.last_publish_time is not None:
                    dt = (now - self.last_publish_time).to_sec()
                    if self.minimum_dt <= dt <= self.maximum_dt:
                        linear_velocity = [
                            (position[i] - self.last_position[i]) / dt for i in range(3)
                        ]
                        angular_velocity = _rotation_vector(self.last_rotation, rotation, dt)
                        alpha = self.velocity_alpha
                        linear_velocity = [
                            alpha * linear_velocity[i]
                            + (1.0 - alpha) * self.filtered_linear_velocity[i]
                            for i in range(3)
                        ]
                        angular_velocity = [
                            alpha * angular_velocity[i]
                            + (1.0 - alpha) * self.filtered_angular_velocity[i]
                            for i in range(3)
                        ]
                self.last_publish_time = now
                self.last_position = list(position)
                self.last_rotation = rotation
                self.filtered_linear_velocity = list(linear_velocity)
                self.filtered_angular_velocity = list(angular_velocity)

                message = Odometry()
                message.header.stamp = now
                message.header.frame_id = self.frame_id
                message.child_frame_id = self.child_frame_id
                message.pose.pose.position.x, message.pose.pose.position.y, message.pose.pose.position.z = position
                (message.pose.pose.orientation.x, message.pose.pose.orientation.y,
                 message.pose.pose.orientation.z, message.pose.pose.orientation.w) = quaternion
                message.pose.covariance = self.pose_covariance

                # px4ctrl读取线速度时通常假定它在世界系中；标准Odometry也可能要求
                # twist在child_frame_id中，所以此处明确做成参数，不能含糊混用。
                if self.twist_linear_frame == "child":
                    message_linear_velocity = _mat_vector(
                        _mat_transpose(rotation), linear_velocity
                    )
                else:
                    message_linear_velocity = linear_velocity
                (message.twist.twist.linear.x, message.twist.twist.linear.y,
                 message.twist.twist.linear.z) = message_linear_velocity
                (message.twist.twist.angular.x, message.twist.twist.angular.y,
                 message.twist.twist.angular.z) = angular_velocity
                message.twist.covariance = self.twist_covariance

                self.publisher.publish(message)
                self.published_frames += 1
                self.rate_window_count += 1
        except Exception as exc:  # 不让异常穿过ctypes回调边界导致进程崩溃。
            rospy.logerr_throttle(1.0, "处理NOKOV帧失败: %s", exc)

    def _status_callback(self, _event):
        """每秒检查数据新鲜度，并周期性报告真实发布频率。"""
        with self.lock:
            now = rospy.Time.now()
            if self.last_receive_time is None:
                rospy.logwarn_throttle(2.0, "已连接NOKOV，但尚未收到动捕帧")
            elif (now - self.last_receive_time).to_sec() > self.stale_timeout:
                rospy.logerr_throttle(
                    1.0, "NOKOV数据已超过%.2fs未更新；Odometry停止在最后一帧",
                    self.stale_timeout,
                )

            elapsed = (now - self.rate_window_start).to_sec()
            if elapsed >= 5.0:
                rate = self.rate_window_count / elapsed
                if self.expected_rate > 0.0 and rate < 0.8 * self.expected_rate:
                    rospy.logwarn(
                        "NOKOV Odometry实际发布频率约%.1fHz，低于期望%.1fHz",
                        rate, self.expected_rate,
                    )
                else:
                    rospy.loginfo("NOKOV Odometry实际发布频率约%.1fHz", rate)
                self.rate_window_start = now
                self.rate_window_count = 0


def main():
    """初始化ROS节点；NOKOV连接或参数错误时以非零状态退出。"""
    rospy.init_node("nokov_odometry")
    try:
        NokovOdometryNode()
        rospy.spin()
    except Exception as exc:
        rospy.logfatal("NOKOV Odometry节点启动失败: %s", exc)
        raise SystemExit(1)


if __name__ == "__main__":
    main()
