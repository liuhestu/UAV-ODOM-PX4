#!/usr/bin/env python3
"""协调px4ctrl固定Odometry无桨起飞测试，并在短时间后自动锁定。

该节点只用于 ``px4ctrl_fixed_odometry_bench.launch``。它不生成飞行控制量，
而是等待MAVROS、固定Odometry、IMU及px4ctrl全部就绪后，向
``/px4ctrl/takeoff_land`` 发布一次TAKEOFF消息。px4ctrl负责OFFBOARD、ARM和
姿态/推力输出；本节点负责限制台架测试时间，并在结束或异常时请求DISARM。

固定Odometry无法反映真实运动，因此该流程严禁安装桨叶，严禁用于实际飞行。
"""

import math
import sys
import time

import rospy
from mavros_msgs.msg import AttitudeTarget, ExtendedState, State
from mavros_msgs.srv import CommandBool
from nav_msgs.msg import Odometry
from quadrotor_msgs.msg import TakeoffLand
from sensor_msgs.msg import Imu


class SequenceError(RuntimeError):
    """启动条件、状态转换或自动锁定失败。"""


class Px4ctrlBenchTakeoffSequence:
    """在全部条件满足后触发一次短时、无桨的px4ctrl起飞流程。"""

    DATA_TIMEOUT = 1.0
    SETPOINT_TIMEOUT = 0.25
    MAX_TEST_DURATION = 3.0

    def __init__(self):
        # 两个确认参数是操作者声明，不是自动检测结果。
        self.confirm_propellers_removed = bool(
            rospy.get_param("~confirm_propellers_removed", False)
        )
        self.confirm_fixed_odometry_bench = bool(
            rospy.get_param("~confirm_fixed_odometry_bench", False)
        )

        # 话题和时序参数。test_duration从PX4确认ARMED后开始计时。
        self.mavros_ns = str(rospy.get_param("~mavros_ns", "/mavros")).rstrip("/")
        self.odom_topic = str(rospy.get_param("~odom_topic", "/test/odometry"))
        self.trigger_topic = str(
            rospy.get_param("~trigger_topic", "/px4ctrl/takeoff_land")
        )
        self.start_timeout = float(rospy.get_param("~start_timeout", 30.0))
        self.setpoint_warmup = float(rospy.get_param("~setpoint_warmup", 3.0))
        self.arm_timeout = float(rospy.get_param("~arm_timeout", 10.0))
        self.test_duration = float(rospy.get_param("~test_duration", 2.0))
        self.disarm_timeout = float(rospy.get_param("~disarm_timeout", 5.0))

        # 最新反馈及本机接收时间，用于判断数据是否持续、新鲜。
        self.state = State()
        self.extended_state = ExtendedState()
        self.odom = None
        self.imu = None
        self.state_received_at = None
        self.extended_state_received_at = None
        self.odom_received_at = None
        self.imu_received_at = None
        self.setpoint_received_at = None

        # 只有已经发布TAKEOFF后，清理阶段才对本次测试的ARM状态负责。
        self.takeoff_triggered = False
        self.cleanup_started = False

        self._validate_parameters()

        rospy.Subscriber(
            self._topic("state"), State, self._state_callback, queue_size=10
        )
        rospy.Subscriber(
            self._topic("extended_state"),
            ExtendedState,
            self._extended_state_callback,
            queue_size=10,
        )
        rospy.Subscriber(self.odom_topic, Odometry, self._odom_callback, queue_size=20)
        rospy.Subscriber(
            self._topic("imu/data"), Imu, self._imu_callback, queue_size=20
        )
        rospy.Subscriber(
            self._topic("setpoint_raw/attitude"),
            AttitudeTarget,
            self._setpoint_callback,
            queue_size=20,
        )
        self.trigger_pub = rospy.Publisher(
            self.trigger_topic, TakeoffLand, queue_size=1
        )

        self.arm_service_name = self._topic("cmd/arming")
        self.arm_service = rospy.ServiceProxy(self.arm_service_name, CommandBool)
        rospy.on_shutdown(self._cleanup)

    def _topic(self, suffix):
        """拼接MAVROS命名空间与相对话题/服务名。"""
        return self.mavros_ns + "/" + suffix.lstrip("/")

    def _validate_parameters(self):
        """要求双重人工确认，并限制所有危险时序参数。"""
        if not self.confirm_propellers_removed:
            raise SequenceError("未确认全部桨叶已拆除，拒绝自动触发")
        if not self.confirm_fixed_odometry_bench:
            raise SequenceError("未确认这是固定Odometry台架测试，拒绝自动触发")
        if not 5.0 <= self.start_timeout <= 120.0:
            raise SequenceError("start_timeout必须在5到120秒之间")
        if not 1.5 <= self.setpoint_warmup <= 15.0:
            raise SequenceError("setpoint_warmup必须在1.5到15秒之间")
        if not 3.0 <= self.arm_timeout <= 30.0:
            raise SequenceError("arm_timeout必须在3到30秒之间")
        if not 0.2 <= self.test_duration <= self.MAX_TEST_DURATION:
            raise SequenceError(
                "test_duration必须在0.2到%.1f秒之间" % self.MAX_TEST_DURATION
            )
        if not 2.0 <= self.disarm_timeout <= 10.0:
            raise SequenceError("disarm_timeout必须在2到10秒之间")

    def _state_callback(self, message):
        """保存PX4连接、模式及ARM状态。"""
        self.state = message
        self.state_received_at = time.monotonic()

    def _extended_state_callback(self, message):
        """保存PX4落地状态。"""
        self.extended_state = message
        self.extended_state_received_at = time.monotonic()

    def _odom_callback(self, message):
        """保存固定Odometry，后续检查数值有限且速度接近0。"""
        self.odom = message
        self.odom_received_at = time.monotonic()

    def _imu_callback(self, message):
        """保存PX4 IMU消息，用于确认MAVROS传感器数据链路工作。"""
        self.imu = message
        self.imu_received_at = time.monotonic()

    def _setpoint_callback(self, _message):
        """记录px4ctrl实际发往MAVROS的姿态setpoint到达时间。"""
        self.setpoint_received_at = time.monotonic()

    @staticmethod
    def _fresh(received_at):
        """最近一秒内收到过消息才视为新鲜。"""
        return (
            received_at is not None
            and time.monotonic() - received_at
            < Px4ctrlBenchTakeoffSequence.DATA_TIMEOUT
        )

    def _odom_valid_and_static(self):
        """验证Odometry位置/速度为有限数，且速度模长小于0.1m/s。"""
        if self.odom is None or not self._fresh(self.odom_received_at):
            return False
        p = self.odom.pose.pose.position
        v = self.odom.twist.twist.linear
        values = (p.x, p.y, p.z, v.x, v.y, v.z)
        return all(math.isfinite(value) for value in values) and math.sqrt(
            v.x * v.x + v.y * v.y + v.z * v.z
        ) < 0.1

    def _ready(self):
        """汇总触发前必须持续满足的连接、落地、数据和订阅条件。"""
        return (
            self._fresh(self.state_received_at)
            and self.state.connected
            and not self.state.armed
            and self._fresh(self.extended_state_received_at)
            and self.extended_state.landed_state
            == ExtendedState.LANDED_STATE_ON_GROUND
            and self._odom_valid_and_static()
            and self._fresh(self.imu_received_at)
            and self.trigger_pub.get_num_connections() > 0
        )

    def _wait_until_ready(self):
        """等待所有节点就绪，并要求条件连续稳定1秒，避免启动瞬态。"""
        deadline = time.monotonic() + self.start_timeout
        stable_since = None
        rate = rospy.Rate(20)
        while not rospy.is_shutdown() and time.monotonic() < deadline:
            if self._ready():
                if stable_since is None:
                    stable_since = time.monotonic()
                elif time.monotonic() - stable_since >= 1.0:
                    return
            else:
                stable_since = None
            rate.sleep()
        raise SequenceError("等待MAVROS、Odometry、IMU或px4ctrl就绪超时")

    def _trigger_takeoff(self):
        """发布一次px4ctrl TAKEOFF事件；这不是PX4原生Takeoff命令。"""
        message = TakeoffLand()
        message.takeoff_land_cmd = TakeoffLand.TAKEOFF
        self.takeoff_triggered = True
        self.trigger_pub.publish(message)
        rospy.logwarn("已向px4ctrl发送无桨台架TAKEOFF触发")

    def _wait_for_arm(self):
        """等待px4ctrl完成OFFBOARD和ARM；拒绝或超时会终止整个launch。"""
        deadline = time.monotonic() + self.arm_timeout
        rate = rospy.Rate(20)
        while not rospy.is_shutdown() and time.monotonic() < deadline:
            if not self.state.connected:
                raise SequenceError("等待ARM期间PX4连接断开")
            if self.state.armed:
                rospy.logwarn("PX4已ARM，开始%.1f秒无桨测试", self.test_duration)
                return
            rate.sleep()
        raise SequenceError("px4ctrl未在限定时间内使PX4进入ARMED")

    def _hold_test_window(self):
        """ARM后只等待有限时长，不再发送任何额外控制目标。"""
        deadline = time.monotonic() + self.test_duration
        rate = rospy.Rate(20)
        while not rospy.is_shutdown() and time.monotonic() < deadline:
            if not self.state.connected:
                raise SequenceError("台架测试期间PX4连接断开")
            if not self.state.armed:
                raise SequenceError("台架测试期间PX4提前DISARM")
            rate.sleep()

    def _disarm_and_wait(self):
        """每秒重试DISARM，并等待/mavros/state确认armed=false。"""
        if not self.takeoff_triggered or not self.state.armed:
            return True
        deadline = time.monotonic() + self.disarm_timeout
        next_attempt = 0.0
        while time.monotonic() < deadline:
            if not self.state.armed:
                return True
            now = time.monotonic()
            if now >= next_attempt:
                try:
                    response = self.arm_service(value=False)
                    if response.success:
                        rospy.loginfo("PX4已接受DISARM请求，等待状态确认")
                    else:
                        rospy.logwarn("PX4拒绝DISARM，将继续重试")
                except (rospy.ServiceException, rospy.ROSException) as exc:
                    rospy.logwarn("DISARM服务调用失败，将继续重试: %s", exc)
                next_attempt = now + 1.0
            time.sleep(0.05)
        return not self.state.armed

    def _cleanup(self):
        """幂等安全退出；若本节点触发过起飞，则确保请求并确认DISARM。"""
        if self.cleanup_started:
            return
        self.cleanup_started = True
        if not self._disarm_and_wait():
            rospy.logfatal(
                "%.1f秒内未确认PX4锁定，请立即使用实体急停/安全开关",
                self.disarm_timeout,
            )
        elif self.takeoff_triggered:
            rospy.loginfo("已确认PX4锁定，无桨测试结束")

    def run(self):
        """等待就绪、触发起飞、限制测试时间并自动锁定。"""
        try:
            rospy.wait_for_service(self.arm_service_name, timeout=self.start_timeout)
        except rospy.ROSException as exc:
            raise SequenceError("等待MAVROS ARM服务超时: %s" % exc)

        self._wait_until_ready()
        self._trigger_takeoff()
        try:
            self._wait_for_arm()
            self._hold_test_window()
        finally:
            self._cleanup()


def main():
    """运行一次顺序测试；退出后required节点会让总launch关闭全部子节点。"""
    rospy.init_node("px4ctrl_bench_takeoff_sequence")
    try:
        Px4ctrlBenchTakeoffSequence().run()
    except (SequenceError, ValueError) as exc:
        rospy.logerr("px4ctrl无桨起飞测试中止: %s", exc)
        return 1
    except rospy.ROSInterruptException:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
