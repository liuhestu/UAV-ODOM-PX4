#!/usr/bin/env python3
"""安全启动NOKOV/px4ctrl，并在Ctrl+C时先降落再关闭整套节点。

必须直接用rosrun启动本程序。它把真正的roslaunch放到独立进程组中，避免
终端Ctrl+C同时杀死MAVROS、NOKOV和px4ctrl。收到退出信号后，本程序会重复
发布px4ctrl LAND，直到MAVROS确认PX4已经DISARM，随后才关闭子launch。
"""

import argparse
import os
import shutil
import signal
import subprocess
import sys
import threading
import time

import rosgraph
import rospy
from mavros_msgs.msg import ExtendedState, State
from quadrotor_msgs.msg import TakeoffLand


class SafeNokovLauncher:
    """管理子launch的生命周期，保证已解锁时先请求降落。"""

    def __init__(self, launch_arguments, landing_timeout, shutdown_timeout):
        self.launch_arguments = launch_arguments
        self.landing_timeout = landing_timeout
        self.shutdown_timeout = shutdown_timeout
        self.child = None
        self.stop_requested = threading.Event()
        self.state_lock = threading.Lock()
        self.state = None
        self.state_time = None
        self.extended_state = None
        self.ever_connected = False
        self.ever_armed = False
        self.land_pub = None

    def request_stop(self, signum, _frame):
        """只记录退出请求；不能在信号处理函数中执行ROS通信。"""
        if not self.stop_requested.is_set():
            self.stop_requested.set()
            message = (
                "\n收到退出信号%d：保持MAVROS、NOKOV和px4ctrl运行，"
                "准备先安全降落。\n" % signum
            )
        else:
            message = (
                "\n安全降落仍在进行；重复Ctrl+C不会强制关闭空中控制链路。"
                "请使用遥控器接管。\n"
            )
        os.write(sys.stderr.fileno(), message.encode("utf-8"))

    def _state_cb(self, message):
        with self.state_lock:
            self.state = message
            self.state_time = time.monotonic()
            if message.connected:
                self.ever_connected = True
            # 只有本次会话中已经连上PX4的ARM状态才可信，避免旧状态串线。
            if message.connected and message.armed:
                self.ever_armed = True

    def _extended_state_cb(self, message):
        with self.state_lock:
            self.extended_state = message

    def _state_snapshot(self):
        with self.state_lock:
            return (
                self.state,
                self.state_time,
                self.extended_state,
                self.ever_connected,
                self.ever_armed,
            )

    @staticmethod
    def _running_ros_nodes():
        """返回当前ROS master登记的节点；master不存在时返回空集合。"""
        master = rosgraph.Master("/safe_nokov_takeoff_preflight")
        try:
            publishers, subscribers, services = master.getSystemState()
        except Exception:
            return set()
        nodes = set()
        for registrations in (publishers, subscribers, services):
            for _name, providers in registrations:
                nodes.update(providers)
        return nodes

    def _assert_no_conflicting_nodes(self):
        """禁止两套飞控链路接入同一ROS master。"""
        existing = self._running_ros_nodes()
        conflicts = sorted(existing.intersection({
            "/mavros",
            "/nokov_odometry",
            "/px4ctrl",
            "/px4ctrl_nokov_takeoff_sequence",
            "/safe_nokov_takeoff_launcher",
        }))
        if conflicts:
            raise RuntimeError(
                "检测到已有飞控节点%s。请先关闭旧launch；不要再单独启动MAVROS、"
                "NOKOV或px4ctrl。" % ", ".join(conflicts)
            )

    def _start_child(self):
        roslaunch = shutil.which("roslaunch")
        if roslaunch is None:
            raise RuntimeError("找不到roslaunch；请先source ROS和工作空间环境")
        command = [
            roslaunch,
            "px4_takeoff_test",
            "px4ctrl_nokov_takeoff.launch",
        ] + self.launch_arguments
        print("安全管理器启动子launch：%s" % " ".join(command), flush=True)
        # 新会话/进程组是安全退出的关键：终端Ctrl+C不会直接传给子launch。
        self.child = subprocess.Popen(command, start_new_session=True)

    def _wait_for_master(self, timeout=30.0):
        deadline = time.monotonic() + timeout
        master = rosgraph.Master("/safe_nokov_takeoff_launcher")
        while time.monotonic() < deadline and not self.stop_requested.is_set():
            if self.child.poll() is not None:
                raise RuntimeError(
                    "子launch在ROS master就绪前退出，返回码%d" % self.child.returncode
                )
            try:
                master.getPid()
                return
            except Exception:
                time.sleep(0.2)
        if self.stop_requested.is_set():
            return
        raise RuntimeError("等待ROS master超时")

    def _init_ros(self):
        rospy.init_node(
            "safe_nokov_takeoff_launcher", anonymous=False, disable_signals=True
        )
        rospy.Subscriber("/mavros/state", State, self._state_cb, queue_size=20)
        rospy.Subscriber(
            "/mavros/extended_state",
            ExtendedState,
            self._extended_state_cb,
            queue_size=20,
        )
        self.land_pub = rospy.Publisher(
            "/px4ctrl/takeoff_land", TakeoffLand, queue_size=1
        )

    def _wait_until_stop_or_child_exit(self):
        """等待人工退出、子launch退出，或一次真实飞行完成并确认锁定。"""
        while not self.stop_requested.wait(0.2):
            if self.child.poll() is not None:
                return "child_exit"
            state, state_time, _extended, _ever_connected, ever_armed = (
                self._state_snapshot()
            )
            if (
                ever_armed
                and state is not None
                and state.connected
                and not state.armed
                and self._state_is_fresh(state_time)
            ):
                rospy.loginfo(
                    "本次飞行已确认PX4 DISARM，自动关闭MAVROS、NOKOV和px4ctrl"
                )
                return "flight_complete"
        return "stop_requested"

    @staticmethod
    def _state_is_fresh(state_time):
        return state_time is not None and time.monotonic() - state_time < 1.0

    def _land_until_disarmed(self):
        """保持子launch运行并重复LAND；只有确认DISARM才允许继续退出。"""
        state, state_time, _extended, _ever_connected, ever_armed = (
            self._state_snapshot()
        )
        # 启动早期尚未ARM时允许退出；飞行后若状态丢失则采取保守策略。
        if state is None and not ever_armed:
            rospy.logwarn("尚未收到MAVROS状态且从未检测到ARM，直接关闭启动流程")
            return True
        if (
            state is not None
            and not state.armed
            and self._state_is_fresh(state_time)
            and (state.connected or not ever_armed)
        ):
            rospy.loginfo("PX4当前未解锁，可以关闭控制节点")
            return True

        rospy.logwarn(
            "PX4处于ARMED状态：开始请求px4ctrl原地缓慢降落；"
            "确认DISARM前不会关闭MAVROS、NOKOV或px4ctrl"
        )
        message = TakeoffLand()
        message.takeoff_land_cmd = TakeoffLand.LAND
        started = time.monotonic()
        next_publish = 0.0
        timeout_reported = False

        while self.child.poll() is None:
            state, state_time, extended, _ever_connected, _ever_armed = (
                self._state_snapshot()
            )
            if (
                state is not None
                and state.connected
                and not state.armed
                and self._state_is_fresh(state_time)
            ):
                if (
                    extended is not None
                    and extended.landed_state
                    == ExtendedState.LANDED_STATE_ON_GROUND
                ):
                    rospy.loginfo("PX4已落地并DISARM，开始关闭全部节点")
                else:
                    rospy.logwarn("PX4已DISARM，开始关闭全部节点")
                return True

            now = time.monotonic()
            if now >= next_publish:
                self.land_pub.publish(message)
                next_publish = now + 0.5

            if not timeout_reported and now - started >= self.landing_timeout:
                timeout_reported = True
                rospy.logfatal(
                    "%.1f秒内未确认PX4 DISARM。为避免空中失控，将继续保持控制链路并发送LAND；"
                    "请立即用遥控器接管并降落。",
                    self.landing_timeout,
                )
            time.sleep(0.05)

        rospy.logfatal("子launch在确认安全落地前意外退出，请立即使用遥控器接管")
        return False

    def _stop_child(self):
        if self.child is None or self.child.poll() is not None:
            return
        os.killpg(self.child.pid, signal.SIGINT)
        try:
            self.child.wait(timeout=self.shutdown_timeout)
            return
        except subprocess.TimeoutExpired:
            rospy.logwarn("子launch未在%.1f秒内退出，发送SIGTERM", self.shutdown_timeout)
        os.killpg(self.child.pid, signal.SIGTERM)
        try:
            self.child.wait(timeout=5.0)
        except subprocess.TimeoutExpired:
            rospy.logerr("子launch仍未退出，发送SIGKILL")
            os.killpg(self.child.pid, signal.SIGKILL)
            self.child.wait(timeout=5.0)

    def run(self):
        self._start_child()
        self._wait_for_master()
        if self.stop_requested.is_set():
            self._stop_child()
            return 0
        self._init_ros()
        rospy.logwarn(
            "安全Ctrl+C管理已启用：退出时将先LAND并等待DISARM，再关闭子launch"
        )
        stop_was_requested = self._wait_until_stop_or_child_exit()
        if not stop_was_requested:
            return self.child.returncode or 0
        if self._land_until_disarmed():
            self._stop_child()
            return 0
        return 1


def parse_arguments():
    parser = argparse.ArgumentParser(
        description=(
            "安全启动px4ctrl_nokov_takeoff.launch；其余name:=value参数原样传给roslaunch"
        )
    )
    parser.add_argument(
        "--landing-timeout",
        type=float,
        default=60.0,
        help="Ctrl+C后等待DISARM的告警时间；超时后仍保持控制链路（默认60秒）",
    )
    parser.add_argument(
        "--shutdown-timeout",
        type=float,
        default=20.0,
        help="确认DISARM后等待子launch退出的时间（默认20秒）",
    )
    parser.add_argument(
        "launch_arguments",
        nargs="*",
        help="传给px4ctrl_nokov_takeoff.launch的name:=value参数",
    )
    arguments = parser.parse_args(sys.argv[1:])
    if not 20.0 <= arguments.landing_timeout <= 300.0:
        parser.error("--landing-timeout必须在20到300秒之间")
    if not 5.0 <= arguments.shutdown_timeout <= 60.0:
        parser.error("--shutdown-timeout必须在5到60秒之间")
    for value in arguments.launch_arguments:
        if ":=" not in value:
            parser.error("无法识别参数%s；launch参数必须使用name:=value格式" % value)
    return arguments


def main():
    arguments = parse_arguments()
    launcher = SafeNokovLauncher(
        arguments.launch_arguments,
        arguments.landing_timeout,
        arguments.shutdown_timeout,
    )
    signal.signal(signal.SIGINT, launcher.request_stop)
    signal.signal(signal.SIGTERM, launcher.request_stop)
    try:
        return launcher.run()
    except (RuntimeError, OSError, subprocess.SubprocessError) as exc:
        print("安全启动失败：%s" % exc, file=sys.stderr)
        if launcher.child is not None and launcher.child.poll() is None:
            launcher._stop_child()
        return 1


if __name__ == "__main__":
    sys.exit(main())
