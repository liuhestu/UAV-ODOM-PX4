<launch>
  <arg name="mission_source" default="propellerless_motor_check" />
  <arg name="mission_config" default="" />
  <arg name="executor_config" default="" />
  <arg name="auto_arm" default="" />
  <arg name="arm_method" default="" />
  <node pkg="uav_system" type="mission_executor_node.py" name="mission_executor" output="screen" required="true">
    <param name="mission_source" type="str" value="$(arg mission_source)" />
    <param name="mission_config" type="str" value="$(arg mission_config)" />
    <param name="executor_config" type="str" value="$(arg executor_config)" />
    <param name="auto_arm_override" type="str" value="$(arg auto_arm)" />
    <param name="arm_method_override" type="str" value="$(arg arm_method)" />
  </node>
</launch>
