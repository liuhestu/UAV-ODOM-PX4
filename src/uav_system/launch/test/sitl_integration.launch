<launch>
  <!-- Requires a separately running PX4 SITL. No fixed mock odometry for flight. -->
  <arg name="source_config" />
  <arg name="start_mission_executor" default="false" />
  <include file="$(find uav_system)/launch/uav_system.launch">
    <arg name="source_config" value="$(arg source_config)" />
    <arg name="simulation_transport" value="true" />
    <arg name="fcu_url" value="udp://:14540@127.0.0.1:14557" />
  </include>
  <include if="$(arg start_mission_executor)" file="$(find uav_system)/launch/mission_executor.launch" />
</launch>
