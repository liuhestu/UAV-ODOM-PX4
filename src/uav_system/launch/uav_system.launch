<launch>
  <arg name="state_source" default="openvins" />
  <arg name="source_config" default="$(find uav_system)/config/state_sources/$(arg state_source).yaml" />
  <arg name="start_mavros" default="true" />
  <arg name="start_source" default="true" />
  <arg name="start_ev_observer" default="true" />
  <arg name="output_enabled" default="true" />
  <arg name="simulation_transport" default="false" />
  <arg name="fcu_url" default="/dev/ttyACM0:57600" />
  <arg name="gcs_url" default="" />
  <include if="$(arg start_mavros)" file="$(find mavros)/launch/px4.launch">
    <arg name="fcu_url" value="$(arg fcu_url)" />
    <arg name="gcs_url" value="$(arg gcs_url)" />
  </include>
  <node pkg="uav_system" type="state_source_manager.py" name="state_source_manager" output="screen" required="true">
    <param name="source_config" value="$(arg source_config)" />
    <param name="start_source" value="$(arg start_source)" />
  </node>
  <node pkg="uav_system" type="state_adapter.py" name="state_adapter" output="screen" required="true">
    <param name="source_config" value="$(arg source_config)" />
  </node>
  <node pkg="uav_system" type="px4_backend.py" name="control_backend" output="screen" required="true">
    <rosparam command="load" file="$(find uav_system)/config/px4.yaml" />
    <param name="output_enabled" type="bool" value="$(arg output_enabled)" />
    <param name="simulation_transport" type="bool" value="$(arg simulation_transport)" />
  </node>
  <node if="$(arg start_ev_observer)" pkg="uav_system" type="px4_ev_observer.py" name="px4_ev_observer" output="screen" required="true">
    <rosparam command="load" file="$(find uav_system)/config/flight_supervisor.yaml" />
  </node>
  <node pkg="uav_system" type="flight_supervisor_node.py" name="flight_supervisor" output="screen" required="true">
    <rosparam command="load" file="$(find uav_system)/config/flight_supervisor.yaml" />
    <param name="backend_output_enabled" value="$(arg output_enabled)" />
    <param name="simulation_transport" value="$(arg simulation_transport)" />
  </node>
</launch>
